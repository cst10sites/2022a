function timeDisplay () {
	if (nClicks == 1){
	var currentTime = new Data()
	var timeLeft = 15.1 - (currentTime - startTime)/1000 
	document.getElementById('timeDisplay').innerHTML = (Math.floor(timeLeft = 10) / 10)
	if(timeLeft <= 0) {
		nClicks = 0
		document.getElementById('timeDisplay').innerHTML = "0"
		document.getElementById('start').innerHTML = "start"
	}
	}
	else {
		location.reset()
	}
}