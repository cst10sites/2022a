body {
	background-color: black;
	color:  white;
	margin: 100px 50px;
	font-family: arial;
}	

h1{
	text-align:center

}	
 
.p {
  font-family: Arial, Helvetica, sans-serif;
} 
 
img.ronaldo {
vertical-align: text-top;
text-align: right;
} 

.topnav {  	
	background-color: #333;
	overflow: hidden;
}


.topnav a {
  float: left;
  color: #f2f2f2;
  text-align: center;
  padding: 14px 16px;
  text-decoration: none;
  font-size: 17px;
}

.topnav a:hover {
  background-color: #ddd;
  color: black;
}

/* Add a color to the active/current link */
.topnav a.active {
  background-color: blue;
  color: white;
}
